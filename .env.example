# ─────────────────────────────────────────────────────────────────────────────
# Proxmox API (required)
# ─────────────────────────────────────────────────────────────────────────────
PROXMOX_HOST=192.168.1.x
PROXMOX_TOKEN_ID=root@pam!mcp-token
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VERIFY_SSL=false

# ─────────────────────────────────────────────────────────────────────────────
# SSH (optional — needed for run_ssh_command)
# Do NOT put inline comments after a value; python-dotenv keeps them as part of
# the value. Leave a var empty by giving it nothing after the '='.
# ─────────────────────────────────────────────────────────────────────────────
PROXMOX_SSH_HOST=
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY=/path/to/.ssh/id_rsa
# PROXMOX_SSH_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Transport (deployment mode)
#   stdio           → local PC / Claude desktop spawns the process (default)
#   streamable-http → persistent network service (e.g. on a Proxmox LXC)
#   sse             → legacy HTTP transport, only if a client requires it
# ─────────────────────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# Auth (HTTP modes only)
# Required whenever MCP_TRANSPORT is streamable-http or sse: this server can run
# arbitrary root shell commands, so a network deployment must be authenticated.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send it as:  Authorization: Bearer <token>
# Set MCP_REQUIRE_AUTH=false ONLY for isolated local testing.
# ─────────────────────────────────────────────────────────────────────────────
MCP_AUTH_TOKEN=
MCP_REQUIRE_AUTH=true

# ─────────────────────────────────────────────────────────────────────────────
# Memory file location (optional)
# Defaults to <project root>/proxmox_memory.md. Override for an LXC/container
# deployment, e.g. /opt/proxmox-homelab/proxmox_memory.md
# ─────────────────────────────────────────────────────────────────────────────
PROXMOX_MEMORY_FILE=
