# Proxmox API (required)
PROXMOX_HOST=192.168.1.x
PROXMOX_TOKEN_ID=root@pam!mcp-token
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VERIFY_SSL=false

# SSH (optional — needed for run_ssh_command)
PROXMOX_SSH_HOST=      # leave empty — defaults to PROXMOX_HOST
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY=/path/to/.ssh/id_rsa
# PROXMOX_SSH_PASSWORD= # use key OR password, not both
