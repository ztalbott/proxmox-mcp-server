# systemd unit for running the Proxmox MCP server as a persistent HTTP service.
#
# Install on the LXC (assumes the repo is at /opt/proxmox-homelab with a venv at
# /opt/proxmox-homelab/.venv and a filled-in /opt/proxmox-homelab/.env):
#
#   sudo cp deploy/proxmox-mcp.service /etc/systemd/system/proxmox-mcp.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now proxmox-mcp.service
#   journalctl -u proxmox-mcp.service -f
#
# Reconfigure (transport, port, MCP_AUTH_TOKEN, SSH key, memory path) by editing
# the .env file, then: sudo systemctl restart proxmox-mcp
#
# NOTE: EnvironmentFile loads .env directly into the service environment, so the
# transport/auth settings are applied no matter how the package was installed.
# Do not remove it — without it the process may fall back to stdio and exit.

[Unit]
Description=Proxmox MCP Server
Documentation=https://github.com/tail412/proxmox-mcp-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/proxmox-homelab
EnvironmentFile=/opt/proxmox-homelab/.env
ExecStart=/opt/proxmox-homelab/.venv/bin/python -m proxmox_mcp.server
Restart=on-failure
RestartSec=5

# Runs as root by default so run_ssh_command can read the SSH key in /root/.ssh.
User=root
Group=root
PrivateTmp=true

# ── Optional hardening ───────────────────────────────────────────────────────
# To run as a dedicated unprivileged user instead of root:
#   1. useradd --system --home /opt/proxmox-homelab --shell /usr/sbin/nologin mcp
#   2. move the SSH key somewhere mcp can read (e.g. /opt/proxmox-homelab/.ssh/)
#      and point PROXMOX_SSH_KEY at it; chown -R mcp:mcp /opt/proxmox-homelab
#   3. set User=mcp / Group=mcp above and uncomment the lines below.
# NoNewPrivileges=true
# ProtectSystem=strict
# ProtectHome=read-only          # 'true' hides /root — breaks an SSH key kept there
# ReadWritePaths=/opt/proxmox-homelab

[Install]
WantedBy=multi-user.target
